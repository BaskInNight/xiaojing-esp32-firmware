# 小净 ESP-IDF 默认配置
# Phase 0: 安全基线 — 默认 FAKE 输出，PTC 禁用
# 不要直接编辑 sdkconfig；修改此文件后运行 idf.py set-target esp32s3

# 目标芯片
CONFIG_IDF_TARGET="esp32s3"

# Flash: 16MB, QIO 80MHz
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 自定义分区表
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: 8MB Octal (OPI) 80MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y

# NimBLE (BLE 小程序协议)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# FreeRTOS
CONFIG_FREERTOS_HZ=100
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# Task WDT
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# 日志默认级别
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Coredump: 写入 Flash，ELF 格式，CRC32 校验
# 大小取决于最大任务栈深度（非平均栈），CAPTURE_DRAM 还包含 .bss/.data/heap。
# Phase 0 按 1MiB 保守预算；Phase 10/11 故障注入后再次校准。
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=32
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
CONFIG_ESP_COREDUMP_CAPTURE_DRAM=y
CONFIG_ESP_COREDUMP_LOGS=y
